export top_level=$(git rev-parse --show-toplevel)
export target_path="./local-cluster"
# Update if mac-k8s repo is not located in the same directory as this repository
export utils_dir="$(realpath ${top_level}/../mac-k8s)"
export config_dir="$(realpath ${top_level}/../mac-k8s)"
export global_config_branch=main # Update if needed, i.e. to use a different branch of mac-k8s repo

if [ -f resources/.vault-init.json ]; then
  export VAULT_TOKEN=$(jq -r '."root_token"' resources/.vault-init.json)
fi

export local_dns=kubernetes.local.internal # Update if needed, add ingress host names to /etc/hosts, e.g. 127.0.0.1 vault.kubernetes.local.internal

export VAULT_ADDR=https://vault.${local_dns}

export GITHUB_GLOBAL_CONFIG_ORG=pc-dae-gitops # Update if needed
export GITHUB_GLOBAL_CONFIG_REPO=mac-k8s # Update if needed

# Update the following values to match your environment.

# The cluster name tells clusters apart when they share New Relic, Splunk, VictoriaMetrics or Loki. setup.sh sets it to
# <cluster type>-<GitHub user>-<machine name>, e.g. kind-paul-carlton-pauls-macbook-air, set CLUSTER_NAME to override it.
# export CLUSTER_NAME=...
export MACHINE=mba
export GITHUB_SERVER=github.com
export GITHUB_MGMT_ORG=pc-dae-gitops
export GITHUB_MGMT_REPO=paulc-dae-mba
export GITHUB_MGMT_BRANCH=main
export USER_EMAIL=paul.carlton@dae.mn
export GITHUB_USER=paul-carlton
export REGISTRY=paulcalrtondae
export FLUX_VERSION=v2.9

export KIND_K8S_VERSION=v1.37.0 # must be a node image supported by the installed kind release
export KIND_CNI=cilium
export KIND_EXTRAS="ca metrics registry mirror audit splunk"
export KIND_HTTP_PORT=80
export KIND_HTTPS_PORT=443
export KIND_DATA_DIR=${HOME}/.kind/${KIND_CLUSTER_NAME:-local}
export DOCKERHUB_USER=${REGISTRY}
export DOCKERHUB_TOKEN=${DOCKERHUB_CREDS:-} # optional, used by mirror.sh to increase docker.io pull rate limit

export CORP_MIRROR=""
export CORP_MIRROR_USER=""
export CORP_MIRROR_TOKEN=""

export IMAGE_PULL_SECRET_NAME=""

export PROXY="false"
PROXY_FILE="${top_level}/local-cluster/local-config/proxy.yaml"
if [ -f ${PROXY_FILE} ]; then
  export PROXY="true"
fi

export CERTS="false"
CA_CERTS_FILE="${top_level}/resources/root-ca.crt"
if [ -f ${CA_CERTS_FILE} ]; then
  export CERTS="true"
fi

[ -f $HOME/.bash_creds.sh ] && source $HOME/.bash_creds.sh
[ -f $utils_dir/bin/lib.sh ] && source $utils_dir/bin/lib.sh
add_to_path ${utils_dir}/bin
